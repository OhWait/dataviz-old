{
  "name": "dataviz-front",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.ts,.vue src/",
    "lint:fix": "eslint --fix --ext .js,.ts,.vue src/",
    "format": "prettier --write src/**/*.{js,ts,vue}",
    "test": "vitest --config vitest.config.ts --printConsoleTrace",
    "test-coverage": "vitest --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "1.7.9",
    "pinia": "^3.0.1",
    "uuid": "^11.0.5",
    "vue": "3.5.13",
    "vue-i18n": "11.1.1",
    "vue-router": "^4.5.0",
    "vuetify": "^3.6.13",
    "vuex": "^4.1.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.5.0",
    "@pinia/testing": "^1.0.0",
    "@types/node": "^22.13.4",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.5",
    "@vue/eslint-config-typescript": "^14.4.0",
    "@vue/test-utils": "^2.4.6",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-vue": "^9.32.0",
    "factory.ts": "^1.4.2",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.1",
    "resize-observer-polyfill": "^1.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vite-plugin-vuetify": "^2.1.0",
    "vitest": "^3.0.5",
    "vue-demi": "^0.14.10",
    "vue-tsc": "^2.2.2"
  },
  "main": "main.ts",
