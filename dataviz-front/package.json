{
  "name": "dataviz-front",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.ts,.vue src/",
    "lint:fix": "eslint --fix --ext .js,.ts,.vue src/",
    "format": "prettier --write src/**/*.{js,ts,vue}",
    "test": "vitest --config vitest.config.ts --printConsoleTrace",
    "test-coverage": "vitest --config vitest.config.ts --coverage"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "axios": "^1.7.2",
    "uuid": "^10.0.0",
    "vue": "^3.4.27",
    "vue-i18n": "9",
    "vue-router": "^4.0.13",
    "vuetify": "^3.6.13",
    "vuex": "^4.0.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@types/node": "^20.14.11",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vitest/coverage-v8": "^2.0.3",
    "@vitest/ui": "^2.0.3",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "axios-mock-adapter": "^1.22.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.27.0",
    "factory.ts": "^1.4.1",
    "jsdom": "^24.1.0",
    "prettier": "^2.8.8",
    "resize-observer-polyfill": "^1.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3",
    "vite": "^5.3.4",
    "vite-plugin-vuetify": "^2.0.3",
    "vitest": "^2.0.3",
    "vue-demi": "^0.14.8",
    "vue-tsc": "^2.0.24"
  },
  "main": "main.ts",
  "repository": "https://github.com/OhWait/dataviz-ui",
  "author": "Maxime",
  "license": "MIT"
