{
  "root": true,
  "env": {
    "node": true,
    "es2020": true
  },
  "extends": [
    "plugin:vue/vue3-strongly-recommended",
    "plugin:@typescript-eslint/recommended",
    "@vue/typescript/recommended",
    "plugin:prettier/recommended"
  ],
  "parserOptions": {
    "ecmaVersion": 2020,
    "parser": "@typescript-eslint/parser"
  },
  "rules": {
    "prettier/prettier": [
      "error",
      {
        "singleQuote": true,
        "semi": true,
        "trailingComma": "es5",
        "arrowParens": "avoid",
        "bracketSameLine": false,
        "bracketSpacing": true,
        "jsxSingleQuote": true,
        "printWidth": 80,
        "tabWidth": 2,
        "useTabs": false,
        "endOfLine": "lf"
      }
    ]
  }
}
